# Optional. Without these, advisory text is produced by the deterministic scorer.
XAI_API_KEY=
XAI_MODEL=grok-4
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Enables the Esri/Web3 upload attempt. Local CID is always computed.
WEB3_STORAGE_TOKEN=

# Filled in by scripts/deploy.js output.
NEXT_PUBLIC_HYDROTRUST_CONTRACT=
NEXT_PUBLIC_CHAIN_ID=31337

# Used by Hardhat when deploying beyond localhost.
ETHEREUM_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Optional. When set, the workspace can open this demo video inside the app.
NEXT_PUBLIC_DEMO_VIDEO_URL=
